// Firebase Storage security rules
rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Publicly readable product images under users/{uid}/products/**
    match /users/{uid}/products/{allPaths=**} {
      allow read: if true; // anyone can view product photos
      allow write: if request.auth != null && request.auth.uid == uid; // only owner writes
    }

    // Everything else locked down by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
