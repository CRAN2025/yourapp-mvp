# -------------------------------
# Firebase (client)
# -------------------------------
VITE_FB_API_KEY=your-web-api-key
VITE_FB_AUTH_DOMAIN=your-project.firebaseapp.com

# Realtime Database (regional):
# Format: https://<db>-default-rtdb.<region>.firebasedatabase.app
# Example: https://your-project-default-rtdb.europe-west1.firebasedatabase.app
VITE_FB_DB_URL=https://your-project-default-rtdb.<region>.firebasedatabase.app

VITE_FB_PROJECT_ID=your-project

# New storage domain (matches Firebase console; do NOT use .com if console shows firebasestorage.app)
VITE_FB_STORAGE_BUCKET=your-project.firebasestorage.app

VITE_FB_SENDER_ID=000000000000
VITE_FB_APP_ID=1:000000000000:web:abcdef123456

# -------------------------------
# Marketing (client)
# Used by the public storefront CTA button
# Set to "/" if your landing page is this app’s root
# -------------------------------
VITE_MARKETING_URL=/

# -------------------------------
# Billing (client)
# Stripe Price IDs (from your Stripe dashboard)
# -------------------------------
VITE_PRICE_STARTER=price_xxxxxxxxxxxxx
VITE_PRICE_PRO=price_yyyyyyyyyyyyyyy

# Optional endpoints (these defaults work if proxied via Hosting → Functions)
VITE_BILLING_CREATE_CHECKOUT=/createCheckout
VITE_BILLING_CREATE_PORTAL=/createPortal

# -------------------------------
# Functions base (optional)
# Leave blank unless you need to hit emulator or a specific region/domain
# Examples:
# VITE_FUNCTIONS_BASE=http://localhost:5001/your-project/us-central1
# VITE_FUNCTIONS_BASE=https://us-central1-your-project.cloudfunctions.net
# -------------------------------
# VITE_FUNCTIONS_BASE=
